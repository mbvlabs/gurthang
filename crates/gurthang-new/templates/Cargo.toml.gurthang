[workspace]
members = [".", "models"]
resolver = "2"

[package]
name = "{{ project_name }}"
version = "0.1.0"
edition = "2024"
default-run = "{{ project_name }}"

[lib]
name = "{{ crate_name }}"
path = "src/lib.rs"

[[bin]]
name = "{{ project_name }}"
path = "src/main.rs"

[[bin]]
name = "seed"
path = "src/bin/seed.rs"

[[bin]]
name = "export_payloads"
path = "src/bin/export_payloads.rs"

[dependencies]
{{ crate_name }}_models = { path = "models" }
axum = "0.8"
axum-login = "0.18"
chrono = { version = "0.4", features = ["serde"] }
dotenvy = "0.15"
gurthang-http = { path = "{{ source }}/crates/gurthang-http" }
gurthang-inertia = { path = "{{ source }}/crates/gurthang-inertia" }
gurthang-jobs = { path = "{{ source }}/crates/gurthang-jobs" }
include_dir = "0.7"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_urlencoded = "0.7"
sqlx = { version = "0.8", default-features = false, features = [
    "runtime-tokio-rustls",
    "postgres",
    "uuid",
    "chrono",
    "migrate",
] }
thiserror = "2"
time = "0.3"
tokio = { version = "1", default-features = false, features = [
    "macros",
    "rt-multi-thread",
    "signal",
    "net",
    "time",
    "sync",
] }
tower-http = { version = "0.6", features = ["fs", "trace"] }
tower-sessions = "=0.14.0"
tower-sessions-sqlx-store = { version = "0.15", features = ["postgres"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
ts-rs = { version = "11", features = ["uuid-impl"] }
uuid = { version = "1", features = ["v4", "v7", "serde"] }
