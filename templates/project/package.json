{
  "name": "__GURTHANG_PACKAGE_NAME__",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "css:dev": "./bin/tailwindcli -i ./css/base.css -o ./assets/css/style.css --watch",
    "css:build": "./bin/tailwindcli -i ./css/base.css -o ./assets/css/style.css --minify",
    "build": "npm run css:build && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inertiajs/react": "^3.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.2",
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
